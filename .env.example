# ==============================================================================
# ZoneMart Environment Configuration Template (.env.example)
# Copy this file to .env and configure your secrets
# ==============================================================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_SUPPORT_BOT_TOKEN=your_support_bot_token_here

# Telegram User/Chat ID allowed to send commands
ALLOWED_CHAT_ID=your_chat_id_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# Workspace root directory
WORKSPACE_PATH=D:\ZoneMart

# Path to the Antigravity CLI (agy.exe)
AGY_CLI_PATH=C:\Users\DELL\AppData\Local\agy\bin\agy.exe

# Maximum execution time in seconds for a single agent turn
TASK_TIMEOUT_SECONDS=600

# Maintain multi-turn conversation memory across Telegram messages (true/false)
CONTINUE_CONVERSATION=true

# MongoDB Atlas Database Credentials
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/zonemart?retryWrites=true&w=majority
MONGODB_DATABASE=zonemart

# SePay Banking Real-Time Payment API Key
SEPAY_API_KEY=your_sepay_api_key_here

# ZoneMart Payment Webhook Secret Key
ZONEMART_PAYMENT_SECRET=your_webhook_secret_here

# FPT.AI OCR Vision API Key
FPT_AI_API_KEY=your_fpt_ai_key_here

# Firebase Web Client API Key
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Secure Admin Default Password
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_here

# Gmail SMTP Configuration (App Passwords)
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_BACKUP_EMAIL=
GMAIL_BACKUP_APP_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,https://zonemart.vn
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_KEY
