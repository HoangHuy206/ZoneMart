# ==============================================================================
# Telegram <-> Antigravity Bridge Configuration Template
# Copy this file to .env and configure your secrets
# ==============================================================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram User/Chat ID allowed to send commands (Security: Only this ID is permitted)
# Leave empty on first run to get your ID from the bot, or set manually
ALLOWED_CHAT_ID=

# Workspace root directory where the Antigravity agent reads and writes code
WORKSPACE_PATH=D:\ZoneMart

# Path to the Antigravity CLI (agy.exe)
AGY_CLI_PATH=C:\Users\DELL\AppData\Local\agy\bin\agy.exe

# Maximum execution time in seconds for a single agent turn
TASK_TIMEOUT_SECONDS=600

# Maintain multi-turn conversation memory across Telegram messages (true/false)
CONTINUE_CONVERSATION=true

